# Procfit CLI — Configuração do Banco de Dados

# Host do SQL Server
PROCFIT_DB_HOST=localhost
PROCFIT_DB_PORT=1433

# Bancos de dados
PROCFIT_DB_DADOS=PBS_NAZARIA_DADOS_DEVELOPER
PROCFIT_DB_DICIONARIO=PBS_NAZARIA_DICIONARIO_DEVELOPER

# Credenciais
PROCFIT_DB_USER=sa
PROCFIT_DB_PASSWORD=sua_senha_aqui

# Driver ODBC (padrão: ODBC Driver 17 for SQL Server)
PROCFIT_DB_DRIVER=ODBC Driver 17 for SQL Server