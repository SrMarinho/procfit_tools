# Procfit CLI — Configuração via variável de ambiente (fallback)
#
# A forma recomendada é salvar no Windows Credential Manager:
#   procfit config set
#
# Este arquivo é o fallback: valores aqui sobrepõem os defaults
# hardcoded, mas são sobrescritos pelo Credential Manager.

PROCFIT_DB_HOST=localhost
PROCFIT_DB_PORT=1433
PROCFIT_DB_DADOS=PBS_NAZARIA_DADOS_DEVELOPER
PROCFIT_DB_DICIONARIO=PBS_NAZARIA_DICIONARIO_DEVELOPER
PROCFIT_DB_USER=sa
PROCFIT_DB_PASSWORD=sua_senha_aqui
PROCFIT_DB_DRIVER=ODBC Driver 17 for SQL Server